{
  "name": "@zbp/sdd",
  "private": false,
  "version": "0.1.1",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "sdd": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://nexus.zyzbp.cn/repository/npm-hosted/"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
